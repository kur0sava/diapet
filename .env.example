# App Config
APP_ENV=development
APP_VERSION=2.5.0

# Database
DB_NAME=diapet.db
DB_VERSION=1

# Features
ENABLE_ANALYTICS=false
ENABLE_CLOUD_SYNC=false

# Runtime Flags
# PREMIUM_MODE: hidden | unlocked | billing
#   hidden    -> all Pro UI hidden (free utility)
#   unlocked  -> all features free for everyone (recommended for v2.5.0 Soft Launch)
#   billing   -> real Pro gating (requires payment provider, currently not wired)
PREMIUM_MODE=unlocked
AI_PROXY_URL=

# Supabase (used for AI proxy + future cloud features)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Payment provider (provider TBD; leave empty until wired)
PAYMENT_PROVIDER_URL=

# EAS
EAS_PROJECT_ID=your-project-id
