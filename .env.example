# App Config
APP_ENV=development
APP_VERSION=1.0.0

# Database
DB_NAME=diapet.db
DB_VERSION=1

# Features
ENABLE_ANALYTICS=false
ENABLE_CLOUD_SYNC=false

# API Keys (never commit real values!)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Supabase (subscription backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Prodamus (payment provider)
PRODAMUS_SHOP_URL=

# EAS
EAS_PROJECT_ID=your-project-id
