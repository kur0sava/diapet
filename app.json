{
  "expo": {
    "name": "DiaPet",
    "slug": "diapet",
    "version": "2.5.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "diapet",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D42020"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.diapet.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "DiaPet needs camera access to take photos of your pet's symptoms.",
        "NSPhotoLibraryUsageDescription": "DiaPet needs photo library access to attach photos to symptom records."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D42020"
      },
      "package": "com.diapet.app",
      "versionCode": 22,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-image-picker",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app"
    ],
    "extra": {
      "eas": {
        "projectId": "b4a89637-64fe-470c-94a7-732162d80caa"
      }
    },
    "owner": "kurosava"
  }
}
