{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-native",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "../.webenc-build",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@core/*": ["src/core/*"],
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared/*"],
      "@storage/*": ["src/storage/*"],
      "@navigation/*": ["src/navigation/*"]
    }
  },
  "include": ["generateWebEncyclopedia.ts", "globals.d.ts"]
}
